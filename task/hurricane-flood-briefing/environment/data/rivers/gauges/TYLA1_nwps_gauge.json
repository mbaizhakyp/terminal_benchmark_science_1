  "impacts": [
   {
    "stage": 138,
    "statement": "There is considerable flooding in Autaugaville. In addition...most of Benton is flooded at this level. "
   },
   {
    "stage": 136.5,
    "statement": "Most of Benton Road from US 80 to Edsons is flooded. County Road 15 from the Lock to Days Bend floods. "
   },
   {
    "stage": 135.5,
    "statement": "Sections of Benton Road off of US Hwy 80 are flooded."
   },
   {
    "stage": 135,
    "statement": "In Benton, Calhoun and Church Street are flooded. Sections of 1st through 4th Streets are flooded along with sections of Commerce and Market Streets."
   },
   {
    "stage": 134,
    "statement": "Portions of Autaugaville begin to flood. In addition...sections of the western railway of Alabama Railroad begin to flood at this level. At 135 feet considerable flooding occurs in Benton. "
   },
   {
    "stage": 132,
    "statement": "Portions of Benton begin to flood. Numerous house trailers along the river become flooded if not moved to higher ground. "
   },
   {
    "stage": 130,
    "statement": "Sections of Praire Creek Campground will begin to flood as water rises to stages of 130 to 135. "
   },
   {
    "stage": 127,
    "statement": "Widespread flooding of farm lands and some homes and trailers along the river occurs. "
   },
   {
    "stage": 122,
    "statement": "Flooding of agricultural lands begins. "
   }
  ]
 },
