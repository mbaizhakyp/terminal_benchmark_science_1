  "lowWaters": {
   "historic": []
  },
  "impacts": [
   {
    "stage": 43,
    "statement": "Flooding from the Cahaba River extends up to 2 miles to the east and one-half mile to the west of the river. "
   },
   {
    "stage": 40,
    "statement": "Extensive overflow of farm lands around Marion Junction occurs. Some homes and farms begin to be affected. Water begins to overflow sections of CR 209 between CR 214 and 818. Water overflows property around the intersections of CR 29, 209 and 818 including the church and graveyard."
   },
   {
    "stage": 36,
    "statement": "Flooding is confined mainly to farm and pasture lands in the area."
   },
   {
    "stage": 15,
    "statement": "Flooding around Oakmulgee Creek begins and cattle need to be moved to higher ground. Overflow of pasture lands increases at stages above 20 feet. "
   }
  ]
 },
