  "impacts": [
   {
    "stage": 33,
    "statement": "Flood waters reach I 65 and flooding of the interstate will occur as water levels rise above this stage."
   },
   {
    "stage": 32.7,
    "statement": "The CSX railroad bridge between Wells Road and Old Selma Road will begin to flood. "
   },
   {
    "stage": 30,
    "statement": "The CSX railroad bridge just west of US 31 will begin to flood as water rises above 30 feet. "
   },
   {
    "stage": 29,
    "statement": "Water reaches the US 31 bridge at Catoma Creek and the road begins to flood. Water begins to overflow  US 331 near the bridge crossing over Catoma Creek as water rises above 29 feet. "
   },
   {
    "stage": 28,
    "statement": "Considerable residential and street flooding occurs in the the vicinity of Old Selma and Hayneville Roads. Water overflows the bridge on Old Selma Road as water rises above 28 feet. Residential flooding occurs along Grovewood Drive and Fleming Road.  Industrial and commercial flooding also occurs along the Mobile-Selma Highway and Interstate 65."
   },
   {
    "stage": 27.5,
    "statement": "The CSX railway will begin to flood in the vicinity of the bridge next to US 331 as water rises above 27.5 feet. "
   },
   {
    "stage": 24,
    "statement": "Residential and street flooding becomes a problem...and increases rapidly above 24 feet. Several residences are threatened."
   },
   {
    "stage": 20,
    "statement": "Flooding of agricultural lands in the vicinity of the U.S. 331 Highway Bridge occurs."
   }
  ]
 },
