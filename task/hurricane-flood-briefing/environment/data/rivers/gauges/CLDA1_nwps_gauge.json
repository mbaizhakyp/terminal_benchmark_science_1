  "impacts": [
   {
    "stage": 47,
    "statement": "Widespread flooding of lowlands. Portions of State Highway 114 on the west side of the river near Naheola Landing become covered by water."
   },
   {
    "stage": 44,
    "statement": "Extensive flooding of lowlands. Some cabins and trailers along the river may become inundated."
   },
   {
    "stage": 40,
    "statement": "Widespread flooding of timber and pastureland. Portions of State Highway 114 east of the river becomes covered by water. Cabins on Old Ferry Road flood."
   },
   {
    "stage": 29,
    "statement": "Pastureland becomes flooded. Livestock should be moved to higher ground. Old Ferry Road near the river begins to flood."
   }
  ]
