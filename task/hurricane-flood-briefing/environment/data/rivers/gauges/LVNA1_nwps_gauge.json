  "impacts": [
   {
    "stage": 30,
    "statement": "Approximately 15 homes are inudated in the Johnson and McKee Street areas. Much of Arrington Street becomes inundated. "
   },
   {
    "stage": 28,
    "statement": "The bridge along Arrington Street in southeast Livinston floods. Residents may become trapped along McKee Street. "
   },
   {
    "stage": 27,
    "statement": "Whiterock Creek begins to overflow into yards in the Arrington (Happy Hollow) Street area."
   },
   {
    "stage": 26,
    "statement": "Considerable overflow along Johnson and McKee streets. Some evacuations may become necessary as water continues to rise."
   },
   {
    "stage": 25,
    "statement": "Water reaches the foundation of homes in southeast Livingston along McKee Street. Water overflows property around Hudson Avenue and Hudson Valley Road in the town of Bellamy. Also in Bellamy, several yards along Westward Ho Street and Lee Street flood with water beginning to cover the roads. "
   },
   {
    "stage": 24,
    "statement": "Yards along Johnson and McKee Streets begin to flood in southeast Livingston."
   },
   {
    "stage": 21,
    "statement": "Overflow of low-lying agricultural lands increases.  Cattle and farm equipment should be moved to higher ground."
   },
   {
    "stage": 18,
    "statement": "Flooding of farm lands around Livingston occurs. "
   }
  ]
 },
