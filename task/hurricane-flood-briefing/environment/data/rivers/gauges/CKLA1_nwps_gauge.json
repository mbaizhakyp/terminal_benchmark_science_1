  },
  "impacts": [
   {
    "stage": 36,
    "statement": "Flood waters will reach the Bibb County High School buildings on the east side of campus next to the river. Homes on the east side of the river and across from the high school will be in danger of flooding.  "
   },
   {
    "stage": 35,
    "statement": "Parking lot on the north side of Bibb County High School campus will begin to flood."
   },
   {
    "stage": 33.5,
    "statement": "Chamber of Commerce parking lot in Centreville will flood and Commerce building will begin to flood as water rises. High School football field will begin to flood as water overflows the Commerce parking lot. "
   },
   {
    "stage": 31,
    "statement": "Access road next to the east of the high school will flood. "
   },
   {
    "stage": 30,
    "statement": "Considerable flooding of farm and pasture lands in the area occurs...and cattle may need to be moved to higher ground."
   },
   {
    "stage": 23,
    "statement": "Pasture lands begin to flood in the Centreville area. The river walk next to the Commerce building and school is nearly completely flooded by this stage. "
   }
  ]
 },
