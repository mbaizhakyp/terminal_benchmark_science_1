  "impacts": [
   {
    "stage": 153,
    "statement": "Water reaches the top of the levee at Northport. At higher stages flooding of Northport can be expected. "
   },
   {
    "stage": 149,
    "statement": "Extensive business and industrial flooding occurs along the Jack Warner Parkway in Tuscaloosa. "
   },
   {
    "stage": 147,
    "statement": "Flooding along Jack Warner Parkway worsens. The park at Manderson Landing floods at stages of 148 feet. "
   },
   {
    "stage": 146,
    "statement": "Considerable flooding of industrial and commercial interests along Jack Warner Parkway occurs. "
   },
   {
    "stage": 144,
    "statement": "Flooding of Rice Mine Road in Northport and northeast Tuscaloosa begins. "
   },
   {
    "stage": 140,
    "statement": "Flooding of portions of Jack Warner Parkway can be expected. Some industrial property may also begin to flood along Jack Warner Parkway. Residential flooding will commence in areas southwest of Tuscaloosa at stages above 140 feet. "
   },
   {
    "stage": 135,
    "statement": "Numerous camphouses and some permanent residences southwest of Tuscaloosa become cutoff."
   },
   {
    "stage": 132,
    "statement": "Flooding of rural roads southwest of Tuscaloosa occurs."
   },
   {
    "stage": 129,
    "statement": "Flooding of agricultural lands in areas southwest of Tuscaloosa occurs. Elevated property just off Flag Road and along View Lane near the Knoxville area will flood. Areas along River Beach Road near Moundville will flood. Areas along River Bend Road will flood. "
   },
   {
    "stage": 125,
    "statement": "Flooding of some roads leading into homes in the Hemphill Bend area southwest of Tuscaloosa occurs. "
   },
   {
    "stage": 122,
    "statement": "Cattle in low lands begin to be cut off and may need to be moved to higher ground. "
   }
  ]
