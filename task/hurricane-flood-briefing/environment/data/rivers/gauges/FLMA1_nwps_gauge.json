  "impacts": [
   {
    "stage": 35.1,
    "statement": "Highway 31 bridge becomes flooded."
   },
   {
    "stage": 30.9,
    "statement": "Town flooded from railroad tracks on west side of town east to the river."
   },
   {
    "stage": 30,
    "statement": "Most of Flomaton will become flooded as the level rises above 30 feet."
   },
   {
    "stage": 22.5,
    "statement": "Flooding of Highway 31 begins east of the high school to the Highway 29 intersection. Flooding of Palafox Street and streets east of Palafox, from Highway 31 south to Roosevelt and Railroad Street occurs. Evacuations may be required."
   },
   {
    "stage": 21,
    "statement": "Water approaches streets and homes in southeast Flomaton, along with Highway 31 on the north side of town."
   },
   {
    "stage": 19,
    "statement": "Water begins to approach several homes on north side of Highway 31."
   },
   {
    "stage": 16.5,
    "statement": "Minor overflow of low lying areas will occur and water may enter the yards of a few homes in the north and east side of town."
   },
   {
    "stage": 13,
    "statement": "Water reaches bankfull."
   }
