  "lowWaters": {
   "historic": []
  },
  "impacts": [
   {
    "stage": 28,
    "statement": "Water breaches the bridge over the Flint River on Brownsboro Road. Major flooding causes evacuations of the area."
   },
   {
    "stage": 26.5,
    "statement": "Water breaches Wall Road. Major flooding is occurring on both the left and right bank with evacuations necessary and homes flooded. "
   },
   {
    "stage": 25.5,
    "statement": "The intersection of Brownsboro Road and Wall Road on the right bank is flooded. The bridge over the Flint River is still not breached but likely cannot be reached by car from either side. Significant flooding is occurring on the left bank and evacuations are likely necessary. "
   },
   {
    "stage": 25,
    "statement": "Water begins to cover the Highway 72 bridges over the Flint River. Highway 72 may have to be closed. "
   },
   {
    "stage": 23.5,
    "statement": "Significant flooding is occurring between the Flint River and a manmade levee created by railroad tracks on the left bank. Water breaches a driveway on the downstream right bank and may be approaching a home on the upstream right bank. "
   },
   {
    "stage": 22,
    "statement": "Flood waters begin to affect yards on the right bank. Homes are not threatened on the right bank at this stage. Brownsboro Road north of the Flint River is closed due to high waters. At least two homes on the left bank are threatened by floodwaters. The gage house becomes inaccessible. "
   },
   {
    "stage": 21,
    "statement": "Floodwaters reach a house trailer off of Brownsboro Road and waters likely cover Brownsboro Road to the point that it must be closed. "
   },
   {
    "stage": 20,
    "statement": "Backwater on a nearby tributary added to floodwaters from the Flint River both reach a small bridge on Brownsboro Road. "
   },
   {
    "stage": 19,
    "statement": "Water begins to flood yards on the downstream side of the Brownsboro Road bridge. "
   },
   {
    "stage": 17,
    "statement": "Water floods a large field on the upstream left bank and is flooding large portions of the downstream left bank."
   },
   {
    "stage": 15,
    "statement": "Water begins to flood the downstream left bank. "
   }
  ]
 },
