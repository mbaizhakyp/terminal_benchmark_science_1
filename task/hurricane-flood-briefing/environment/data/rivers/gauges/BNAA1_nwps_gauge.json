   },
   {
    "stage": 24.97,
    "statement": "Record Stage. Observed March 16, 1973. "
   },
   {
    "stage": 20,
    "statement": "Water is approaching homes south of downtown Courtland...with several streets impassible. Water reaches the underside of the bridge at Old Highway 20 in Courtland. "
   },
   {
    "stage": 16,
    "statement": "Water begins to cover roads south of downtown Courtland. "
   },
   {
    "stage": 14,
    "statement": "Lowland flooding begins on the left bank of the river.  "
   },
   {
